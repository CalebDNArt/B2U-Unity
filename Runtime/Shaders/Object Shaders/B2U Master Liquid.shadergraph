{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "faf3ff63c755439ab1b8f20aeafc3ce9",
    "m_Title": "Vertex Displacement",
    "m_Content": "To give the liquid more realism, we can use the noise to offset the mesh vertices. Unfortunately because we need an interpolated version in the fragment, we have to run the noise sampling twice. Once in the vertex stage and once in the fragment stage. This function is almost identical to the large surface mask block in the middle of the shader, with some trimming to custom functions to improve performance.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1719.0,
        "y": -1211.0,
        "width": 334.0,
        "height": 130.0
    },
    "m_Group": {
        "m_Id": "49d39dc599f14e2092ba6a979de42f51"
    }
}

