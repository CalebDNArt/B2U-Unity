{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "163d02e249bc4be2a2be507913b84566",
    "m_Title": "Apply Alpha",
    "m_Content": "Unity has a built in keyword for the lit master shader called _SURFACE_TYPE_TRANSPARENT that is active when the material surface type is overrided to transparent. By checking for this keyword being active, we can feed it in the Vertex Red, otherwise for opaques it feeds a value of 1.",
