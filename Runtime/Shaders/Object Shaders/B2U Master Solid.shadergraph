{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "5961608894754348b45a47ceb76eb3b7",
    "m_Title": "Calculate Triplanar Normals, Curvature, and Heightmap",
    "m_Content": "Calculates the final triplanar blended object space normal, curvature, and heightmap. Since we packed the curvature and heightmap into Vector3s, we can just take the dot product of it with the blend weights to get the same result as multiplying each corresponding axis and summing the results. ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
