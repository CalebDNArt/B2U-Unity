{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e2899b84dae443edbe4ce19241c3fb75",
    "m_Title": "Determine Propertiesm Colors, and Branches",
    "m_Content": "Samples both the color-emission LUT & property LUT to determine all of the material's properties as well as the biome blended color. This specific node only works for solids as liquids have many more properties baked into the second row of the LUT. Also determines all of the branches for the shader.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1774.0,
