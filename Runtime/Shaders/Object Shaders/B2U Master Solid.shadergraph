{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "af6576beba0b4718be1df2e8e4800a4a",
    "m_Title": "Unpacking UVs",
    "m_Content": "If a value is constant across an entire polygon, we can pack two 16-bit floats into a single 32-bit U or V channel. B2U packs the spherical grain vector (azimuth, altitude) into the 32-bit U channel. It packs the texture scale (X, Y) into the 32-bit V channel. Then on a secondary UV map it packs the edge distances for edges 1 & 2 into U, and edge distances for edges 3 & 4 into V. By running an asset postprocessor, we tell unity to merge these two vector2 UV channels into one vector4 UV channel and bit shift the values to get 8 properties out of 4 32-bit floats. This then has to be passed to the vertex stage interpolator to tell it to leave the values uniform across the face.  ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 4679.0,
        "y": -1865.0,
        "width": 375.0,
        "height": 183.0048828125
    },
    "m_Group": {
        "m_Id": "e87b56622b934356897ca5330f80e18e"
    }
}

