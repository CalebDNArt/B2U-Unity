    "m_SourceType": 1,
    "m_FunctionName": "B2U_Triplanar_Blend",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 adn = abs(Decoded_Normal);\nfloat3 finalWeights = pow(adn, Triplanar_Blend_Power);\nOut_Weights = finalWeights / (finalWeights.x + finalWeights.y + finalWeights.z);"
}

