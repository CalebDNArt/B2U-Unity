    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6b72d8c5b0ba4cfab4e7357b8877ff15",
    "m_Title": "Triplanar Blending",
    "m_Content": "Calculates what direction the face is pointing and how much each axis' sample influences that face. Higher power reduces blurry boundaries between samples but causes the texture to stretch more on faces between samples. ",
