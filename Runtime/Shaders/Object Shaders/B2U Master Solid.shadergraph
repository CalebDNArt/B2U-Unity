{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e03e881a58d941d1a5108ca388d5f971",
    "m_Title": "Calculate Iridescence",
    "m_Content": "B2U gives the option to have iridescence for surfaces. It uses a small iridescence LUT to overwrite the base colour. There are three modes: Ambient simply uses the normal & view vectors (NdotV) to sample the LUT. Main Light applies a small ambient sample, as well as a large specular sample using the half vector of the light and view vectors (NdotH). All Lights samples the lut multiple times in a loop for the main light and the 4 closest lights to the object and combines their colors. ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1819.0,
        "y": 206.0,
        "width": 307.0,
        "height": 155.0
    },
    "m_Group": {
        "m_Id": "44d4d94ab21746e7bdbb1cdec0997a88"
    }
}

