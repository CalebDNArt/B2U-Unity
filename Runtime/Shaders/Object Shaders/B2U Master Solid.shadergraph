{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "02205748b2cf4b9bb29417b6b8f4ffa3",
    "m_Title": "Global 3D Noise",
    "m_Content": "To break up repetition in the surface normal and color, we multiply our normal strength and tint the color by a noise map. There are two options, true procedural 3D noise which never repeats but is much more computationally expensive, and a baked Texture3D noise which is much more performant but can look repetitive on large flat surfaces. The position is sampled in object space and multiplied by the object scale to keep the map from stretching. Using object space positions prevents the noise from moving around if the object moves. To prevent two identical objects having the same noise, we bake a random 6 bit value into the RSUV and use that to randomly offset the object positions.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2022.0,
        "y": -1717.0,
        "width": 594.0,
        "height": 127.8968505859375
    },
    "m_Group": {
        "m_Id": "25fd920ddcc64811a0d99e8b3125bf74"
    }
}

