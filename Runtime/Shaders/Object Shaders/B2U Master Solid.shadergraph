{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "87fbc30a2c1b470d87d594e83d6bcfa5",
    "m_Title": "Unpack RSUVs",
    "m_Content": "As of Unity 6.3, there is now a per-renderer (effectively per gameobject) 32-bit unsigned int that is passed directly to the GPU with the rest of the object data. This allows for per object material control without breaking batching or instancing. In our case, we pack this uint with several values. First is a noise offset, this offsets the sampling of the 3D noise texture and makes it so two identical objects dont have the exact same noise pattern. Next we have object painting. The is painted bool drives whether or not to use the base color from the LUT or the override painted color from the paint palette texture2d array. The next is emission strength, this is an override emission strength that allows you to control the emission strength per object. The value is inverted so by default the value is 1. The last is crack intensity. This drives the formation of procedural cracks on the surface of an object. Use it if you want to make an object have a damage effect. ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2447.0,
        "y": -943.0,
        "width": 271.0,
        "height": 314.5355224609375
    },
    "m_Group": {
        "m_Id": "7dcf5790753747018516171c1656198f"
    }
}

