    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 finalWeights = pow(abs(Decoded_Normal), Triplanar_Blend_Power);\nOut_Weights = finalWeights / (finalWeights.x + finalWeights.y + finalWeights.z);"
}

