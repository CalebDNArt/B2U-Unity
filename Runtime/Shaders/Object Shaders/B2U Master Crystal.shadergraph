{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9ba606bcee9f4efb945003620c4a87f8",
    "m_Title": "Emission",
    "m_Content": "The emission method for crystals is nearly identical to solids in that it uses a grain vector and triplanar projection to place the emission pattern on the surface. Unlike solids, the crystals have a built in fresnel effect to make it so only the edges glow. If you want the entire thing to glow, just simply remove the multiply above and feed the subgraph output directly to the \"On\" of Is Emissive.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -568.0,
        "y": 1076.0,
        "width": 250.0,
        "height": 170.0
    },
    "m_Group": {
        "m_Id": "97b2316c8f7b43eaa6c160dcd878dbdc"
    }
}

