{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "66d57e92e1cb42638afb7c456b003f70",
    "m_Title": "Transmission, Refraction, & Flares",
    "m_Content": "Unlike the liquids which are likely to take up large portions of the screen, crystals are less likely to occupy a lot of pixels. Because of this, we can use a more indepth system for the optics of the crystal. Using the backface buffer, we can generate much more physics accurate transmission and refraction. With this you can see the internal facets of the crystal and it distorts what is seen through it. Flares are a bit more complex, the flares have options for ambient, main light, or all lights. Ambient simply causes flares at certain angles when a facet is viewed. The two light responsive modes use the half vector of incoming light to generate flares that are accurate to the internal reflection of the backfaces.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 386.0,
        "y": 916.0,
        "width": 431.0,
        "height": 174.0
    },
    "m_Group": {
        "m_Id": "1776c2eaa823476b88dd620c0c70b4a5"
    }
}

