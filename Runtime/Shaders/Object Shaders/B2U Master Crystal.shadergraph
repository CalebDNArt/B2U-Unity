{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "e6006e9a363340c5a336057e2ea06c9a",
    "m_Title": "Get Crystal Colors & Properties",
    "m_Content": "Like all of the other B2U shaders, the crystal data is stored in the LUTs generated by blender. Crystal's don't actually have many properties so I condensed the branch determination, color sampling, and property sampling down into a single node.",
