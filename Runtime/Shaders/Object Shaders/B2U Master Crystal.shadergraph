{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "c4774f80944646a283df1bb956fac7d6",
    "m_Title": "Evaluate Lighting",
    "m_Content": "To allow for different styles for your project, all B2U master shaders are unlit. Instead of using the shadergraph lit master, we apply custom lighting models. This function takes in all of the neccessary surface data from the rest of the fragment shader, and solves the final color/lighting. Doing it this way lets us have things like a default URP model, a lightweight model, and a toon model (with more planned), all within the same shader.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1264.0,
        "y": 441.0,
        "width": 245.0,
        "height": 185.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

