{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "fe938a021c22443f967f9cbb1161725a",
    "m_Title": "Solve Transmission, Absorption, Refraction, & Caustics",
    "m_Content": "This subgraph holds a custom function which solves transmission and refraction. It uses the materials transmission (how much light passes through - effectively the alpha), absorption (how much light of certain wavelengths is absorbed as it passes through the liquid), and the index of refraction (how much light bends as it enters/exits the liquid). It uses these three values to fake refraction and sample the background scene color offset by this refraction vector. Then it fades the image between the background and the liquid surface, as well as tints the color more or less towards the liquid color depending on how far light has to travel. It also supports chromatic abberation which is caused when different wavelengths of light refract slightly different amounts when entering a medium. You also have the option to generate volumetric refraction by adding the B2UVolumetricRefraction render feature. This writes a custom depth-normals buffer for the backfaces of marked liquid meshes. Using this it can calculate volumetric absorption and double-refraction. Depending on the quality mode it will also execute color copy passes during the transparent queue to allow for you to see different liquids/transparents though each other. Another feature nested in here is the ability to enable caustics. Similar to iridescence, caustics can be driven from only the main light, or the main light + the 4 closest lights to the fragment.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -248.0,
        "y": -1385.0,
        "width": 336.0,
        "height": 392.0
    },
    "m_Group": {
        "m_Id": "f5ec3470a9164d7bbc28bf82146abec2"
    }
}

