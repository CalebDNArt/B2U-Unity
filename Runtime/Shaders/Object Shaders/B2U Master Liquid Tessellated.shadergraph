{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8cec8b44e2b645b1be60d8026c33c712",
    "m_Title": "Tessellation",
    "m_Content": "In some cases, you may not want to have masively subdivided meshes for your liquids, but up close they look too blocky. The solution is tessellation! Tessellation dynamically subdivides triangles into smaller ones based on the distance from the camera. Tessellation is a hardware feature and may not be supported on some GPUs (Namely mobile). While is helps create crisp waves for vertex displacement, it is expensive as it dramatically increases the number of vertices (often 10-100s of times). Use it sparingly when you want ultra high resolution liquids. The way we force shadergraph to run it is that we create a dummy function inside the tessellation include \"B2U_Tessellation.hlsl\", having the function in the graph ensures that shadergraph runs the hull and domain stages of the tessellator. The function itself always returns 1 and we simply multiply that by the object position and feed it to the vertex context. If we don't do this, shadergraph sees a disconnected node and culls it from the final shader.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1644.0,
        "y": -1008.0,
        "width": 488.0,
        "height": 194.0
    },
    "m_Group": {
        "m_Id": "238163e3c4fc48228b615239fcc8c46b"
    }
}

