{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1a6a2af809ad48e7b829e8601c29cdc5",
    "m_Title": "Get Material Properties & Colors",
    "m_Content": "Just like the solids, we need to extract our material properties and colors from the LUTs. To be able to have a surface & depth color, liquids allocate 2 rows of the LUT. This also gives more space to pack in all of the properties needed. The major blocks are: Transmission, Noise Properties, Fluid Dynamics, and Emission. ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -5471.0,
