{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6dbb5687eb2d4c5db23bc01a4e7f45c5",
    "m_Title": "Solve Emission",
    "m_Content": "Solving emission is very similar to how we do it for solids, except for two major differences. 1) The blend weights and sampling axes are the objects major axes with no grain vector, and 2) we give the option to have the emission texture affected by the flow vectors to give the look that the emission pattern is also flowing. ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 157.0,
