{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "f5c12899da274e279b948b6b8f3b6632",
    "m_Title": "Procedural Noise",
    "m_Content": "To avoid having any repetition, there is a keyworded option to use procedural noise. Because we don't use traditional UVs, we can't use 2D voronoi functions to make cells. Instead we sample in 3D using a custom function. While this is excellent looking and guarantees no repetition. It is VERY expensive compared to a texture lookup. For every fragment, the shader must calculate 27 sets of sin(), frac(), floor() and other math functions which can quickly clog ALU bandwidth on low-end GPUs. Use this method if targeting mid-high tier graphics hardware. ",
    "m_TextSize": 0,
    "m_Theme": 0,
