    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Transmission = Optical_Properties.r;\nAbsorption = Optical_Properties.r;\nIOR = Optical_Properties.b;\nViscosity = Optical_Properties.a;\nSurface_Color = Surface_And_Scale.rgb;\nNoise_Scale = Surface_And_Scale.a;\nDepth_Color = Depth_And_isTransmissive.rgb;\nisTransmissive = Depth_And_isTransmissive.a == 1;"
}

